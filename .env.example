# TailorIT configuration. Copy to `.env` (never commit it). One file feeds both apps.
# Saved from PowerShell? UTF-16 is fine; the launchers decode it.

# --- Core -----------------------------------------------------------------------------------------------------------
# The address people open. Google sign-in must list it as an authorized JavaScript origin.
APP_ORIGIN=http://localhost:3100
WEB_PORT=3100
# Where the web server listens (dev and start). localhost (the default) keeps it to this computer
# (http://localhost:3100 and http://127.0.0.1:3100 both work); to serve other people, put a reverse proxy in front.
# 0.0.0.0 listens on every network interface (your LAN, and beyond if the firewall allows). WARNING: never combine
# 0.0.0.0 with AUTH_DEV_FIXED_CODE, or anyone who can reach the server signs in as any address, administrators included.
WEB_HOST=localhost
API_PORT=4100
# Where the web server reaches the API (server-to-server; the browser always uses /api on APP_ORIGIN).
API_INTERNAL_URL=http://127.0.0.1:4100
# Database, uploads and caches. Default: %LOCALAPPDATA%\TailorIT on Windows, ~/.local/share/tailorit elsewhere.
DATA_DIR=
LOG_LEVEL=info

# --- Sign-in (passwordless: Google button + six-digit email code) ---------------------------------------------------
SESSION_TTL_DAYS=30
# Accounts with these emails become administrators (comma or space separated).
ADMIN_EMAILS=
# Shown as "Contact admin" on the sign-in page (mailto).
CONTACT_EMAIL=
# Google Identity Services client id (no secret needed).
GOOGLE_CLIENT_ID=
# SMTP for sign-in codes. Port 465 = implicit TLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Development only (ignored when NODE_ENV=production): print codes to the API console when SMTP is not set,
# and/or accept one fixed code (automated tests). With a fixed code set, anyone who can reach the server can sign in
# as any address: keep WEB_HOST=localhost (the API warns at every start while it is set).
AUTH_DEV_LOG_CODES=true
AUTH_DEV_FIXED_CODE=

# --- AI (local Claude CLI, signed in to a subscription; no API key) ------------------------------------------------
AI_ENABLED=true
# Path or name of the CLI. Tests point this at tools/fake-claude/fake-claude.mjs.
AI_CLI_BIN=claude
AI_CLI_MODEL=claude-sonnet-5-5
AI_CLI_EFFORT=low
AI_CLI_FALLBACK_MODEL=
AI_CLI_CONCURRENCY=4
AI_CLI_BACKGROUND_SLOTS=1
AI_CLI_TIMEOUT_MS=300000
AI_CLI_FIRST_EVENT_MS=30000
# Per-feature overrides (empty = AI_CLI_MODEL / AI_CLI_EFFORT).
AI_MODEL_RESUME_IMPORT=
AI_MODEL_BULLETS=
AI_MODEL_JOB_ANALYSIS=
AI_MODEL_COVER_LETTER=
AI_MODEL_TEMPLATE_FILL=
AI_EFFORT_RESUME_IMPORT=
AI_EFFORT_BULLETS=
AI_EFFORT_JOB_ANALYSIS=
AI_EFFORT_COVER_LETTER=
AI_EFFORT_TEMPLATE_FILL=
# lazy = AI job analysis the first time a job is opened; off = deterministic analysis only.
AI_JOB_ANALYSIS=lazy
# Background AI analyses per hour for popular jobs (0 = off).
AI_JOB_ANALYSIS_WARMUP_PER_HOUR=0

# --- Rendering and files --------------------------------------------------------------------------------------------
# Chrome/Edge for PDF export (blank = auto-detect an installed Chrome/Edge).
CHROME_PATH=
PDF_RENDER_TIMEOUT_MS=30000
PDF_MAX_CONCURRENCY=2
UPLOAD_MAX_MB=5

# --- Job ingestion --------------------------------------------------------------------------------------------------
INGEST_ENABLED=true
# Daily run time (24h, server local time unless INGEST_TIMEZONE is set).
INGEST_DAILY_AT=03:30
INGEST_TIMEZONE=
INGEST_HTTP_TIMEOUT_MS=30000
# Identify yourself to job boards (include a contact address).
INGEST_USER_AGENT=TailorIT job ingest (contact: admin@example.com)
# free_tailor's Job Data Lake, opened read-only. Default: %LOCALAPPDATA%\free_tailor\db\free_tailor.db
FT_LAKE_DB_PATH=
FT_LAKE_MAX_AGE_DAYS=45

# --- Development ----------------------------------------------------------------------------------------------------
# Load the demo data set on first start of an empty database.
SEED_DEMO=false
