{
  "name": "tailorit",
  "private": true,
  "description": "TailorIT: a Simplify-style job search, job tracker and documents app",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:webpack": "node scripts/dev.mjs --webpack",
    "build": "npm run build -w @tailorit/api && npm run build -w @tailorit/web",
    "start": "node scripts/start.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "shots": "playwright test --project=shots",
    "golden:ft": "node tools/ft-golden/generate.mjs",
    "skills:synonyms": "node tools/skills/library-synonyms.mjs",
    "db:migrate": "node scripts/run-api-script.mjs db:migrate",
    "seed:demo": "node scripts/run-api-script.mjs seed:demo",
    "doctor": "node scripts/doctor.mjs",
    "setup:browser": "node scripts/install-browser.mjs",
    "seed:jobs": "node scripts/run-api-script.mjs seed:jobs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pixelmatch": "7.1.0",
    "@types/pngjs": "6.0.5",
    "eslint": "9.39.5",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
